server {
    listen {{ service_bind_address }}:80;
    server_name _;
    root /var/www/middleware;
    index index.html;

    location = /stub_status {
        stub_status;
        allow 127.0.0.1;
        allow 10.0.0.0/8;
        allow 172.16.0.0/12;
        allow 192.168.0.0/16;
        deny all;
        access_log off;
    }

    location / {
        try_files $uri $uri/ =404;
    }
}
